# 默认 mock：不联网、不花钱、无需 API Key。
MODEL_PROVIDER=mock

# 切换真实 API 时改成 openai，并在你自己的 .env 中填写密钥。
# 不要把真实密钥提交到 Git。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

MODEL_REASONING_EFFORT=low
RAG_TOP_K=4
MAX_AGENT_STEPS=4

# Temperature 与 Top-p 通常只调一个；留空表示使用模型默认值。
MODEL_TEMPERATURE=
MODEL_TOP_P=
